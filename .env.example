# Copy this file to ".env" and fill in real values for your environment.
# Never commit the real ".env" file to version control.

DATABASE_URL=sqlite:///./network_monitor.db
METRICS_DATABASE_URL=sqlite:///./metrics.db

# Path where Cisco configuration backups are stored. Relative paths are
# resolved against the backend/ directory.
BACKUP_PATH=backups

PING_INTERVAL=15
METRICS_INTERVAL=300
BACKUP_INTERVAL=300

# 32+ byte random string used to derive the AES-256 key for encrypting
# stored device credentials. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

ENVIRONMENT=demo

# Optional: credentials used ONLY when bootstrapping a brand-new (empty)
# database with the default device list. Leave unset to bootstrap devices
# without credentials (configure them later via Register/Edit Device).
# SEED_DEVICE_USERNAME=
# SEED_DEVICE_PASSWORD=
